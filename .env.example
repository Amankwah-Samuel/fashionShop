# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. Server only, never share or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin/login. Use something long.
ADMIN_PASSWORD=c433fd8756a253414a93a00deb896d7988563d6b723377645c17212ffe54f559
# Random string (32+ characters) used to sign the admin login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
